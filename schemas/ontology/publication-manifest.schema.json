{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dpa-ontology-workbench/schemas/ontology/publication-manifest.schema.json",
  "title": "Publication Manifest",
  "description": "本体发布集合清单：版本锁、内容摘要、签署记录与原子发布。",
  "type": "object",
  "additionalProperties": false,
  "required": ["publication_id", "published_at", "published_by", "models", "content_digest"],
  "properties": {
    "publication_id": {
      "type": "string",
      "minLength": 1
    },
    "published_at": {
      "type": "string",
      "format": "date-time"
    },
    "published_by": {
      "type": "string",
      "minLength": 1
    },
    "models": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["model_id", "version", "sha256"],
        "properties": {
          "model_id": { "type": "string", "minLength": 1 },
          "version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
          "sha256": { "type": "string", "pattern": "^[A-Fa-f0-9]{64}$" }
        }
      }
    },
    "content_digest": {
      "type": "string",
      "pattern": "^[A-Fa-f0-9]{64}$"
    },
    "review_refs": {
      "type": "array",
      "items": { "type": "string" }
    }
  }
}
