{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dpa-ontology-workbench/schemas/evidence/snapshot-manifest.schema.json",
  "title": "Evidence Snapshot Manifest",
  "description": "证据快照清单与完整性校验契约。",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "snapshot_id",
    "source_revision",
    "generator_version",
    "config_digest",
    "files",
    "created_at"
  ],
  "properties": {
    "snapshot_id": {
      "type": "string",
      "pattern": "^snap-[A-Za-z0-9_.-]+-[A-Za-z0-9.-]+-[A-Fa-f0-9]{8,64}$"
    },
    "source_revision": {
      "type": "string",
      "minLength": 1
    },
    "generator_version": {
      "type": "string",
      "minLength": 1
    },
    "config_digest": {
      "type": "string",
      "pattern": "^[A-Fa-f0-9]{64}$"
    },
    "files": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "sha256"],
        "properties": {
          "path": { "type": "string", "minLength": 1 },
          "sha256": { "type": "string", "pattern": "^[A-Fa-f0-9]{64}$" }
        }
      }
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    }
  }
}
