# DPA 试点环境变量模板（本文件入 git；真实值填在 .env，.env 不入 git）
# 纪律：只填测试环境值；生产地址/凭据永不落盘，上线时走 secret 管理（WP11）。

DPA_TEST_BASE_URL=              # 测试环境 DPA 站点，同源反代转发目标
DPA_TEST_DB_HOST=               # 测试库主机
DPA_TEST_DB_PORT=1433           # SQL Server 默认端口
DPA_TEST_DB_NAME=               # 测试库名
DPA_TEST_DB_USER=               # 测试库账号（只读原则；平台消费走 Database MCP/受治理查询）
DPA_TEST_DB_PASSWORD=           # 测试库密码
DPA_TEST_REVISION=              # 测试环境部署的 DPA revision，须与 evidence/snapshots/<revision> 一致

# ── Gateway（MVP 竖切）──
GATEWAY_WRITE_MODE=local_json   # local_json=本地沙箱写操作库（默认）| dpa_http=经 DPA 原业务链写入
GATEWAY_PORT=8000
GATEWAY_QUERY_TIMEOUT_SECONDS=8
GATEWAY_ROW_LIMIT=50

# ── LLM（可选；不填则 Agent 退回关键词路由）──
LLM_BASE_URL=                   # OpenAI 兼容端点，网关代理时填到部署名一级
LLM_API_KEY=                    # 模型服务密钥（敏感：只填 .env，不入 git）
LLM_MODEL=                      # 如 gpt-5 / deepseek-chat / qwen-plus
LLM_API_VERSION=                # 可选：网关代理要求 api-version 查询参数时填（如 2025-03-01-preview）
