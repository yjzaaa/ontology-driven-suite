# ===== DeepSeek AI 配置 =====
# 请填入你的 DeepSeek API Key（复制本文件为 .env 后填入）
DEEPSEEK_API_KEY=your-deepseek-api-key

# DeepSeek API 地址（默认值，一般无需修改）
DEEPSEEK_BASE_URL=https://api.deepseek.com

# 默认模型 — 改为你实际使用的模型 ID（如 DeepSeek V4 Pro 的真实 model id）
DEEPSEEK_MODEL=deepseek-chat

# 推理增强模型（阶段三复杂推理任务）
DEEPSEEK_REASONING_MODEL=deepseek-reasoner

# ===== 数据库配置 =====
SYSTEM_DB_PATH=./backend/data/system.db
DEMO_DB_PATH=./backend/data/demo_ecommerce.db

# ===== 应用配置 =====
FLASK_PORT=5000
FLASK_DEBUG=true
FLASK_ENV=development

# 前端开发服务器地址（用于 CORS）
FRONTEND_ORIGIN=http://localhost:5173

# ===== 功能配置 =====
# SQL 最大返回行数
MAX_SQL_ROWS=10000
# AI 推理温度
AI_TEMPERATURE=0.1
# 最大 Token 数
AI_MAX_TOKENS=4096
# AI 生成 YAML 失败时的最大重试次数
AI_YAML_MAX_RETRIES=2
# 场景执行时 AI 生成 SQL 失败的最大重试次数
AI_SQL_MAX_RETRIES=2
